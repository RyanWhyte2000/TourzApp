NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Main search options and mobile category links (unset defaults to true).
# Set to false to hide an option. Restart dev / rebuild production after changes.
# These control navigation visibility, not direct access to category URLs.
NEXT_PUBLIC_FEATURE_TRANSPORT=true
NEXT_PUBLIC_FEATURE_AIRBNB=true
NEXT_PUBLIC_FEATURE_FOOD=false
NEXT_PUBLIC_FEATURE_HOTEL=true
